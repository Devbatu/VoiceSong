/* ============================================================
   genrePatterns — Genre-aware random music generation engine
   Generates coherent drum beats, bass lines, chord progs,
   and melodies in specific musical styles using Web Audio
   ============================================================ */

// ---- Types ----
export interface GenreDef {
  id: string
  name: string
  emoji: string
  bpmRange: [number, number]
  timeSignature: [number, number]
  swingAmount: number          // 0-1
  bars: number                 // typical pattern length
  drumPattern: DrumPatternGen
  chordProgressions: number[][] // semitones from root, multiple options
  scales: number[][]           // scale intervals (multiple options)
  bassStyle: 'root' | 'walking' | 'octave' | 'arpeggio' | 'syncopated' | 'offbeat'
  melodyDensity: number        // 0-1, chance of note per 16th
  melodyRange: [number, number] // octave range offset from root
  synthType: OscillatorType
  padSynthType: OscillatorType
  bassSynthType: OscillatorType
  useArpeggio: boolean
  arpeggioSpeed: number        // in 16th notes
  reverbAmount: number         // 0-1 wet mix
  delayTime: number            // seconds, 0 = off
  filterFreq: number           // Hz, lowpass cutoff
}

export interface DrumPatternGen {
  kick: number[]     // step indices (16th notes) with probability weights
  snare: number[]
  hihat: number[]
  openhat: number[]
  clap: number[]
  tom: number[]
  rim: number[]
  perc: number[]
  kickProb: number   // 0-1
  snareProb: number
  hihatProb: number
  variation: number  // 0-1, chance of per-step mutation
}

export interface GeneratedSong {
  bpm: number
  bars: number
  timeSignature: [number, number]
  drums: GeneratedDrumTrack
  bass: GeneratedNoteTrack
  chords: GeneratedNoteTrack
  melody: GeneratedNoteTrack
  arpeggio: GeneratedNoteTrack | null
}

export interface GeneratedDrumTrack {
  steps: Map<string, boolean[]>  // instrument → step active
  velocities: Map<string, number[]>
}

export interface GeneratedNote {
  pitch: number      // MIDI note
  startBeat: number
  durationBeats: number
  velocity: number
}

export interface GeneratedNoteTrack {
  notes: GeneratedNote[]
}

// ---- Utility ----
const pick = <T>(arr: T[]): T => arr[Math.floor(Math.random() * arr.length)]
const rand = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min
const prob = (p: number) => Math.random() < p
const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v))

